# Copie para .env na raiz do repositório. Variáveis do processo têm precedência.
API_HOST=127.0.0.1
API_PORT=8000
APP_ENV=development
SUITS_DATA_MODE=artifacts
SUITS_AI_MODE=local
SUITS_POLICY_MODE=unavailable
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=low
# Limite total por resposta: raciocínio e texto gerado.
OPENAI_MAX_OUTPUT_TOKENS=25000
OPENAI_TIMEOUT_SECONDS=120
OPENAI_API_KEY=
# SUITS_DATABASE_PATH=C:/caminho/local/suits.sqlite3
# SUITS_ARTIFACTS_DIR=C:/caminho/repo/artefacts/Hackaton Unicamp
# SUITS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
